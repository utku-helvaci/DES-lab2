graph NET {
  graph [fontname="Arial", fontsize=11, bgcolor="white", pad=0.15, rankdir=LR, nodesep=0.5,
         ranksep=0.7];
  node  [shape=box, style="rounded,filled", fontname="Arial", fontsize=10.5, fontcolor="#1a1a19",
         fillcolor="#eaf2fc", color="#2a78d6", penwidth=1.3, margin="0.16,0.08"];
  edge  [color="#4a4a48", penwidth=1.3, fontname="Arial", fontsize=9.5, fontcolor="#3a3a38"];
  subgraph cluster_host {
    label="Host computer (Linux, Docker Engine) - docker-compose.yml"; labeljust=l;
    style="rounded"; color="#9a9993"; fontcolor="#6b6a64";
    A [label=<<b>machine-a</b>  (container = computer A)<br/>hostname machine-a<br/>eth0  172.28.10.10/24<br/><font face="Arial" point-size="10.5">tcpClient -s 172.28.10.20</font><br/><font point-size="9" color="#6b6a64">Machine A: sends first</font>>];
    BR [label=<<b>des_lan</b> (virtual Ethernet switch)<br/>Linux bridge  des-lan0<br/>subnet 172.28.10.0/24<br/>gateway 172.28.10.1>, fillcolor="#f3f3f1", color="#8a8984"];
    B [label=<<b>machine-b</b>  (container = computer B)<br/>hostname machine-b<br/>eth0  172.28.10.20/24<br/><font face="Arial" point-size="10.5">tcpServer   (0.0.0.0:9000)</font><br/><font point-size="9" color="#6b6a64">Machine B: receives first</font>>];
    S [label=<<b>sniffer</b> (optional)<br/><font face="Arial" point-size="10.5">tcpdump -i des-lan0</font><br/><font point-size="9" color="#6b6a64">sees only IV + ciphertext</font>>, fillcolor="#fdeee7", color="#c4501f"];
  }
  A -- BR [label="veth pair"];
  BR -- B [label="veth pair"];
  BR -- S [style=dashed, label="capture"];
  A -- B [style=bold, color="#2a78d6", fontcolor="#2a78d6", constraint=false,
          label=<TCP 172.28.10.10:&lt;ephemeral&gt;  &lt;-&gt;  172.28.10.20:9000<br/>frame = length | mode | IV | DES ciphertext>];
}