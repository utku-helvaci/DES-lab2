digraph ROUND {
  
  graph [fontname="Arial", fontsize=11, bgcolor="white", pad=0.15, newrank=true];
  node  [shape=box, style="rounded,filled", fontname="Arial", fontsize=10.5, fontcolor="#1a1a19",
         fillcolor="#eaf2fc", color="#2a78d6", penwidth=1.3, margin="0.14,0.06"];
  edge  [color="#4a4a48", arrowsize=0.7, penwidth=1.1, fontname="Arial", fontsize=9.5,
         fontcolor="#3a3a38"];

  ranksep=0.32; nodesep=0.6;
  L  [label="L(i-1)  (32 bits)", fillcolor="white", color="#8a8984", style="rounded"];
  R  [label="R(i-1)  (32 bits)", fillcolor="white", color="#8a8984", style="rounded"];
  E  [label=<<b>Expansion/permutation E</b>  [2.3]<br/><font point-size="9" color="#6b6a64">32 -&gt; 48 bits</font><br/><font face="Courier New" point-size="9">des_expansion_permutation()</font>>];
  X  [label=<<b>XOR with round key</b>  [2.5]<br/><font point-size="9" color="#6b6a64">48 XOR 48 bits</font><br/><font face="Courier New" point-size="9">des_xor_round_key()</font>>];
  K  [label="Ki (48 bits)", fillcolor="#fdeee7", color="#c4501f"];
  S  [label=<<b>S-boxes S1 ... S8</b>  [2.6]<br/><font point-size="9" color="#6b6a64">48 -&gt; 32 bits, 8 x des_sbox_lookup(): 6 -&gt; 4</font><br/><font face="Courier New" point-size="9">des_sbox_substitution()</font>>];
  PP [label=<<b>Permutation P</b>  [2.7]<br/><font point-size="9" color="#6b6a64">32 -&gt; 32 bits = f(R(i-1), Ki)</font><br/><font face="Courier New" point-size="9">des_permutation_p()</font>>];
  XL [label=<<b>XOR with left half</b>  [2.8]<br/><font point-size="9" color="#6b6a64">L(i-1) XOR f</font><br/><font face="Courier New" point-size="9">des_xor_left_half()</font>>];
  SW [label=<<b>Swap of the halves</b>  [2.9]<br/><font point-size="9" color="#6b6a64">(L XOR f) | R  -&gt;  R | (L XOR f)</font><br/><font face="Courier New" point-size="9">des_swap_halves()</font>>];
  LO [label="Li = R(i-1)", fillcolor="white", color="#8a8984", style="rounded"];
  RO [label="Ri = L(i-1) XOR f(R(i-1), Ki)", fillcolor="white", color="#8a8984", style="rounded"];
  subgraph cluster_f {
    label="Feistel function f(R, K) - des_feistel()"; labeljust=l; style="rounded,dashed";
    color="#9a9993"; fontcolor="#6b6a64"; fontsize=10;
    E; X; S; PP;
  }
  R -> E -> X -> S -> PP;
  K -> X;
  PP -> XL [label="  f (32)"];
  L -> XL;
  XL -> SW [label="  L XOR f"];
  R -> SW [label="R(i-1)", style=dashed];
  SW -> LO; SW -> RO;
  { rank=same; L; R; }
  { rank=same; X; K; }
  { rank=same; LO; RO; }
}