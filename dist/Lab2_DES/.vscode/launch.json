{
    // Debug configurations for the lab (needs the C/C++ extension, ms-vscode.cpptools).
    // Suggested breakpoints: the "return ..." line of each step function in src/des.c;
    // add the parameter and the returned local to the WATCH panel (see README.md).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DES steps: textbook example (des_trace -q)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/des_trace",
            "args": ["-q", "-k", "0f1571c947d9e859", "-i", "02468aceeca86420"],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "preLaunchTask": "make",
            "stopAtEntry": false,
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "set output-radix 16", "ignoreFailures": true }
            ]
        },
        {
            "name": "tcpServer (Machine B, port 9000)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/tcpServer",
            "args": ["-1", "-n"],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "preLaunchTask": "make",
            "externalConsole": false
        },
        {
            "name": "tcpClient (Machine A -> 127.0.0.1:9000)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/tcpClient",
            "args": ["-s", "127.0.0.1", "-n"],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "preLaunchTask": "make",
            "externalConsole": false
        }
    ]
}
